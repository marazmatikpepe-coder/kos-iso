#!/usr/bin/env python3
"""K-OS update client. Runs from a systemd timer; asks the user via zenity (swap for the shell's own UI later).
Config /etc/k-os/update.json: {"server":"https://your.site","pubkey":"<base64>","version":"1.0.0"}
Package = tar.gz with optional install.sh (runs as root). Manual check: kos-updater.py --now"""
import json, sys, os, hashlib, base64, subprocess, tempfile, tarfile, urllib.request
from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
CFG = os.environ.get("KOS_CONF", "/etc/k-os/update.json"); C = json.load(open(CFG))
vt = lambda v: tuple(int(x) for x in v.split("."))
def ask(text):
    if os.environ.get("KOS_AUTO"): return True
    return subprocess.run(["zenity", "--question", "--title=K-OS", "--text", text, "--ok-label=Обновить", "--cancel-label=Позже"]).returncode == 0
m = json.load(urllib.request.urlopen(C["server"] + "/api/latest.json", timeout=15))
if not m or vt(m["version"]) <= vt(C["version"]): print("up to date"); sys.exit(0)
Ed25519PublicKey.from_public_bytes(base64.b64decode(C["pubkey"])).verify(
    base64.b64decode(m["sig"]), json.dumps({k: m[k] for k in ("version", "sha256")}, sort_keys=True).encode())
if not ask(f"Доступна K-OS {m['version']}\n\n{m['notes']}") and not m.get("mandatory"): sys.exit(0)
d = tempfile.mkdtemp(); p = d + "/u.tar.gz"; urllib.request.urlretrieve(m["url"], p)
if hashlib.sha256(open(p, "rb").read()).hexdigest() != m["sha256"]: raise SystemExit("checksum mismatch")
with tarfile.open(p) as t: t.extractall(d + "/x", filter="data")
if os.path.exists(d + "/x/install.sh"): subprocess.run(["bash", d + "/x/install.sh"], check=True)
C["version"] = m["version"]; json.dump(C, open(CFG, "w"))
print("updated to", m["version"])
